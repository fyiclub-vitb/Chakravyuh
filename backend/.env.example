# Backend base URL, INCLUDING /api
VITE_API_URL=http://localhost:5000/api

# ---- Puzzle answers (set these to match your puzzle content) ----
# NOTE: VITE_* values are bundled into the public JS, so players can read them.

# Mumbai: 3-digit code
VITE_MUMBAI_PASSCODE=000

# Bangalore: passcode
VITE_BANGALORE_PASSCODE=

# Pune: device report fields
VITE_PUNE_DEVICE_ID=
VITE_PUNE_FREQUENCY_BAND=
VITE_PUNE_SIGNAL_STRENGTH=
VITE_PUNE_DELAY_OFFSET=

# Chennai: NGO name (case-insensitive, spaces ignored)
VITE_CHENNAI_NGO_NAME=

# Delhi: final answer
VITE_DELHI_CITY=
VITE_DELHI_DATE=15th August
VITE_DELHI_TIME=11 PM
VITE_DELHI_PLACES=
